# =====================================================================
# TriageBridge Environment Configuration (Template / Placeholders Only)
# =====================================================================

# Server-Side Machine Learning Shadow Mode Feature Flag
# Default: false (STRICT REQUIREMENT: Production is safe when missing or false)
# When false: Model never executes. Zero ML predictions.
# When true: Executes silently in technical evaluation mode ONLY.
TRIAGE_ML_SHADOW_ENABLED=false

# Remote Model Service URL (Optional for container/microservice deployments; omit for local subprocess demo)
TRIAGE_ML_SERVICE_URL=http://localhost:8001

# Internal ML Service Authentication Secret (PLACEHOLDER - use strong random value in .env.local)
# STRICT SECURITY: Server-only. Never expose to client bundles (no NEXT_PUBLIC_).
TRIAGE_ML_SERVICE_SECRET=replace_with_strong_random_secret_min_32_chars

# Salt for de-identification hashing of case IDs in shadow audit table (PLACEHOLDER)
TRIAGE_DEID_SALT=replace_with_strong_random_salt_min_32_chars

# Supabase Server-Only Service Role Key (STRICT: NEVER prefix with NEXT_PUBLIC_)
# Bypasses RLS for trusted backend operations only.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Supabase Client Configuration (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
